;; Four dependencies, all of them things this workspace already had:
;;
;;   org-ietf-blake2  — BLAKE2b at 4, 20 and 32 bytes. Filecoin's address
;;                      checksums, address payloads and CIDs are all this
;;                      hash, and neither runtime provides it.
;;   io-multiformats  — base32 (the same lowercase RFC 4648 alphabet
;;                      addresses use), varint, CIDv1 assembly, hex.
;;   org-ietf-cbor    — definite-length CBOR. A message is a 10-element
;;                      array, and re-encoding has to be byte-exact or the
;;                      CID moves and the signature stops matching.
;;   json             — JSON-RPC bodies. Lotus speaks JSON, the chain speaks
;;                      CBOR, and the two encodings of a message are not
;;                      derivable from each other.
;;
;; No Filecoin SDK, no secp256k1, no BLS: signing is a seam
;; (`filecoin.protocols/ISigner`), so this library never holds a key and
;; never pins itself to one curve implementation.
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/org-ietf-blake2
        {:git/sha "5785beab88167f8588c31c3f756573fecefa6076"}
        io.github.kotoba-lang/io-multiformats
        {:git/sha "561fe7dfada3db852b127f06d41750dabd3cead9"}
        io.github.kotoba-lang/org-ietf-cbor
        {:git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        io.github.kotoba-lang/json
        {:git/sha "f6a534458ddfcb88e5e03facb35ebf61902e1bc4"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; classpath only, no :main-opts — `kbb -A:cljs -Spath` resolves the
  ;; git deps for nbb without the deprecation warning `-A` prints when the
  ;; alias carries a main.
  :cljs {:extra-paths ["test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
